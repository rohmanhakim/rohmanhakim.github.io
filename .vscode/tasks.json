{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Markdown: Increase heading levels",
            "type": "shell",
            "command": "sed -i 's/^#/##/g' '${file}'",
            "windows": {
                "command": "powershell -Command \"(Get-Content '${file}') -replace '^#', '##' | Set-Content '${file}'\""
            },
            "presentation": {
                "reveal": "never"
            }
        },
        {
            "label": "Markdown: Decrease heading levels",
            "type": "shell",
            "command": "sed -i 's/^##/#/g' '${file}'",
            "windows": {
                "command": "powershell -Command \"(Get-Content '${file}') -replace '^##', '#' | Set-Content '${file}'\""
            },
            "presentation": {
                "reveal": "never"
            }
        }
    ]
}